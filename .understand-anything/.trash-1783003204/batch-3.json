      "filePath": "services/search_service.py",
      "lineRange": [11, 37],
      "summary": "Searches songs by case-insensitive title or artist match, joining the song_tags table to include tag associations; missing distinct() causes duplicate rows for songs with several tags.",
      "tags": ["search", "database", "bug-candidate"],
      "complexity": "moderate"
    },

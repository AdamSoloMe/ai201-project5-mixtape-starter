    {
      "id": "file:services/search_service.py",
      "type": "file",
      "name": "search_service.py",
      "filePath": "services/search_service.py",
      "summary": "Implements song search and single-song lookup logic, querying the Song model by title/artist and joining tag associations; the outerjoin without a distinct() call can produce duplicate results for multi-tag songs.",
      "tags": ["service", "search", "database", "bug-candidate"],
      "complexity": "simple",
      "languageNotes": "search_songs performs an outerjoin against the song_tags association table but does not deduplicate the resulting rows, so a song with multiple tags can appear multiple times in the results — a likely source of the bug this project's test suite targets."
    },
    {
      "id": "function:services/search_service.py:search_songs",

    {
      "id": "file:services/streak_service.py",
      "type": "file",
      "name": "streak_service.py",
      "filePath": "services/streak_service.py",
      "summary": "Service layer implementing listening-streak logic: recording listening events and updating/reading a user's consecutive-day listening streak.",
      "tags": ["service", "streak", "business-logic"],
      "complexity": "moderate",
      "languageNotes": "update_listening_streak special-cases today.weekday() != 6 (Sunday) when deciding whether to increment the streak, so a consecutive-day listen falling on a Sunday resets the streak to 1 instead of incrementing — likely one of the project's intentional bugs, and directly exercised by test_streak_increments_on_sunday."
    },
    {
      "id": "function:services/streak_service.py:record_listening_event",
      "type": "function",
      "name": "record_listening_event",
      "filePath": "services/streak_service.py",
      "lineRange": [14, 39],
      "summary": "Validates the user exists, creates a ListeningEvent for the given song, and triggers a streak update before committing the transaction.",
      "tags": ["streak", "listening-event", "transaction"],
      "complexity": "moderate"
    },
    {
      "id": "function:services/streak_service.py:update_listening_streak",
      "type": "function",
      "name": "update_listening_streak",
      "filePath": "services/streak_service.py",
      "lineRange": [42, 78],
      "summary": "Computes the day delta since the user's last listen and updates listening_streak: starts at 1 for first-ever listens, no-ops for same-day repeats, increments for consecutive days (except when today is Sunday, where it resets), and resets to 1 otherwise.",
      "tags": ["streak", "date-logic", "bug-suspect"],
      "complexity": "moderate"
    },
    {
